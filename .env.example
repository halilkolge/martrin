# Martrin ortam değişkenleri

# exFAT gibi AppleDouble (._*) dosyası üreten disklerde Turbopack dosya sistemi
# önbelleğini kapatmak için 1 yapın. Boş ya da 0 ise önbellek açık kalır.
MARTRIN_DISABLE_TURBO_CACHE=0

# Yerel PostgreSQL + PostGIS
# Makinede 5432'yi başka bir PostgreSQL kullanıyorsa DB_PORT değerini değiştirin;
# DB_PORT değişirse DATABASE_URL içindeki portu da aynı değere güncelleyin.
DB_PORT=5432
DATABASE_URL=postgres://martrin:martrin@localhost:5432/martrin

# Sentry hata izleme. Sunucu ve edge tarafı için DSN. Boşsa Sentry devre dışı.
SENTRY_DSN=
# Tarayıcı tarafı için DSN. Boşsa istemci hataları Sentry'ye gönderilmez.
NEXT_PUBLIC_SENTRY_DSN=
